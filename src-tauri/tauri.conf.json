{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "danmaku-hub",
  "version": "0.2.0",
  "identifier": "com.danmakuhub.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Danmaku Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://live.douyin.com https://*.douyin.com wss://*.douyin.com ws: wss:; img-src 'self' https://*.douyin.com https://*.douyinstatic.com https://*.douyincdn.com https://*.douyinpic.com data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/845292122/dy-danmaku/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyN0QzRTgxRUE5RUREM0IKUldRNzNaN3FnVDU5UXZWZ3V0ZlhKRFFiT05QK0pKWGFiMEdvaytVQnUyK0pncUtzQnZYU3R6SlcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
